{
  "_doc": [
    "Which jars a trial needs. 'match' is a case-insensitive filename prefix inside the instance's",
    "mods/ (or mods/1.7.10/). 'role': base = loaded in every trial (cheap visual/performance/pack",
    "fixes), lib = pulled in only through 'requires', mod = loaded only when asked for.",
    "'requires' names other entries by key. mcmod.info declares almost none of these, so they are",
    "kept by hand; when a trial dies on NoClassDefFoundError, trial.py names the jar that owns the",
    "class -- add it here so the next agent does not pay for the same boot."
  ],
  "base": ["optifine", "betterfps", "fastcraft", "fastleafdecay", "aiimprovements", "qftweaks", "soundfilters"],
  "bundles": {
    "inspect":  {"mods": ["nei", "waila"], "why": "look up IDs, block names and item tooltips in-game"},
    "quests":   {"mods": ["betterquesting", "bqstandard", "questbook"], "why": "quest book and its task types"},
    "tweaker":  {"mods": ["crafttweaker", "modtweaker2"], "why": "MineTweaker scripts/ (recipes, removals)"},
    "qf":       {"mods": ["qfcontent", "qfcommands"], "why": "all of the pack's own code"},
    "spawning": {"mods": ["jas"], "why": "the pack's spawn tables; without it vanilla spawning rules apply"},
    "hud":      {"mods": ["damageindicators", "journeymap"], "why": "the player-facing HUD as shipped"},
    "menu":     {"mods": ["custommenu"], "why": "the branded title screen (the splash lives in the Forge jar, not here)"}
  },
  "mods": {
    "optifine":        {"match": "OptiFine",               "role": "base", "why": "renderer + Sildur's shaders; every visual result depends on it"},
    "betterfps":       {"match": "BetterFps",              "role": "base", "why": "math/AI patches, coremod, near-zero boot cost"},
    "fastcraft":       {"match": "fastcraft",              "role": "base", "why": "render/chunk optimizer the pack ships with OptiFine"},
    "fastleafdecay":   {"match": "FastLeafDecay-1.7.10",   "role": "base", "why": "tiny coremod"},
    "aiimprovements":  {"match": "AIImprovements",         "role": "base", "why": "mob AI cost; changes server tick time"},
    "qftweaks":        {"match": "QuestForgeTweaks-1.0.jar", "role": "base", "why": "pack coremod: GL error log, chunk clean, music ticker; trials must see the pack's fixes"},
    "soundfilters":    {"match": "SoundFilters",           "role": "base", "why": "reverb/occlusion, client only"},

    "qfcontent":       {"match": "QuestForgeContent-1.0.0.jar", "role": "mod"},
    "qfcommands":      {"match": "QuestForgeCommands",     "role": "mod"},

    "codechickenlib":  {"match": "CodeChickenLib",         "role": "lib"},
    "codechickencore": {"match": "CodeChickenCore",        "role": "lib", "requires": ["codechickenlib"]},
    "forgemultipart":  {"match": "ForgeMultipart",         "role": "lib", "requires": ["codechickencore"]},
    "codinglib":       {"match": "CodingLib",              "role": "lib"},
    "openmodslib":     {"match": "OpenModsLib",            "role": "lib"},
    "ichunutil":       {"match": "iChunUtil",              "role": "lib"},
    "voltzengine":     {"match": "VoltzEngine",            "role": "lib"},
    "malisiscore":     {"match": "malisiscore",            "role": "lib"},
    "movingworld":     {"match": "MovingWorld",            "role": "lib"},
    "ivtoolkit":       {"match": "IvToolkit",              "role": "lib"},
    "animationapi":    {"match": "AnimationAPI",           "role": "lib"},
    "darkcore":        {"match": "DarkCore",               "role": "lib"},
    "origin":          {"match": "Origin",                 "role": "lib"},
    "asielib":         {"match": "asielib",                "role": "lib"},
    "mobiuscore":      {"match": "MobiusCore",             "role": "lib"},
    "saintscore":      {"match": "Saintscore",             "role": "lib"},
    "baubles":         {"match": "Baubles",                "role": "lib"},

    "nei":             {"match": "NotEnoughItems",         "role": "mod", "requires": ["codechickencore"]},
    "neiaddons":       {"match": "NEIAddons",              "role": "mod", "requires": ["nei"]},
    "neiintegration":  {"match": "NEIIntegration",         "role": "mod", "requires": ["nei"]},
    "waila":           {"match": "Waila",                  "role": "mod"},
    "chickenchunks":   {"match": "ChickenChunks",          "role": "mod", "requires": ["codechickencore"]},
    "enderstorage":    {"match": "EnderStorage",           "role": "mod", "requires": ["codechickencore"]},
    "wrcbe":           {"match": "WR-CBE",                 "role": "mod", "requires": ["codechickencore", "forgemultipart"]},
    "openblocks":      {"match": "OpenBlocks",             "role": "mod", "requires": ["openmodslib"]},
    "hats":            {"match": "Hats.jar",               "role": "mod", "requires": ["ichunutil"]},
    "hatstand":        {"match": "HatStand",               "role": "mod", "requires": ["hats", "ichunutil"]},
    "sync":            {"match": "Sync-",                  "role": "mod", "requires": ["ichunutil"]},
    "gravitygun":      {"match": "GravityGun",             "role": "mod", "requires": ["ichunutil"]},
    "portalgun":       {"match": "PortalGun-",             "role": "mod", "requires": ["ichunutil"]},
    "trailmix":        {"match": "TrailMix",               "role": "mod", "requires": ["ichunutil"]},
    "mobamputation":   {"match": "MobAmputation",          "role": "mod", "requires": ["ichunutil"]},
    "mobdismemberment":{"match": "MobDismemberment",       "role": "mod", "requires": ["ichunutil"]},
    "icbm":            {"match": "ICBM",                   "role": "mod", "requires": ["voltzengine"]},
    "malisisdoors":    {"match": "malisisdoors",           "role": "mod", "requires": ["malisiscore"]},
    "archimedes":      {"match": "ArchimedesPlus",         "role": "mod", "requires": ["movingworld"]},
    "recurrentcomplex":{"match": "RecurrentComplex",       "role": "mod", "requires": ["ivtoolkit"]},
    "psychedelicraft": {"match": "Psychedelicraft",        "role": "mod", "requires": ["ivtoolkit"]},
    "mutantcreatures": {"match": "MutantCreatures",        "role": "mod", "requires": ["animationapi"]},
    "tardis":          {"match": "TardisMod",              "role": "mod", "requires": ["darkcore"]},
    "weepingangels":   {"match": "WeepingAngels",          "role": "mod", "requires": ["origin"]},
    "statues":         {"match": "Statues",                "role": "mod", "requires": ["asielib"]},
    "betterquesting":  {"match": "BetterQuesting",         "role": "mod"},
    "bqstandard":      {"match": "StandardExpansion",      "role": "mod", "requires": ["betterquesting"]},
    "questbook":       {"match": "questbook",              "role": "mod", "requires": ["betterquesting"]},
    "crafttweaker":    {"match": "CraftTweaker",           "role": "mod"},
    "modtweaker2":     {"match": "ModTweaker2",            "role": "mod", "requires": ["crafttweaker"]},
    "soulshards":      {"match": "SoulShards",             "role": "mod"},
    "gravestones":     {"match": "GraveStones",            "role": "mod"},

    "legends":         {"match": "1Legends",               "role": "mod", "why": "88 MB, coremod"},
    "tragicmc":        {"match": "TragicMC",               "role": "mod", "why": "110 MB"},
    "mcheli":          {"match": "MCHeli",                 "role": "mod", "why": "270 MB -- the single most expensive jar"},
    "lycanites":       {"match": "LycanitesMobs",          "role": "mod", "why": "41 MB"},
    "orespawn":        {"match": "orespawn",               "role": "mod"},
    "decocraft":       {"match": "Decocraft",              "role": "mod"},
    "customnpcs":      {"match": "CustomNpcs",             "role": "mod"},
    "jungle":          {"match": "WelcomeToTheJungle",     "role": "mod"},
    "witchery":        {"match": "Witchery",               "role": "mod"},
    "inventorypets":   {"match": "inventorypets",          "role": "mod"},
    "bibliocraft":     {"match": "BiblioCraft",            "role": "mod"},
    "custommenu":      {"match": "CustomMenu",             "role": "mod"},
    "chisel":          {"match": "Chisel",                 "role": "mod"},
    "hee":             {"match": "HardcoreEnderExpansion", "role": "mod"},
    "railcraft":       {"match": "Railcraft",              "role": "mod"},
    "twilightforest":  {"match": "TwilightForest",         "role": "mod"},
    "backpack":        {"match": "AdventureBackpack",      "role": "mod"},
    "chocolatequest":  {"match": "chocolateQuest",         "role": "mod"},
    "transformers":    {"match": "TransformersMod",        "role": "mod"},
    "jas":             {"match": "JustAnotherSpawner",     "role": "mod"},
    "journeymap":      {"match": "journeymap",             "role": "mod"},
    "furniture":       {"match": "MrCrayfishsFurnitureMod","role": "mod"},
    "projecte":        {"match": "ProjectE",               "role": "mod"},
    "foodplus":        {"match": "FoodPlus",               "role": "mod"},
    "battlegear":      {"match": "MineBladeBattlegear",    "role": "mod"},
    "littlemaid":      {"match": "littleMaidMob",          "role": "mod"},
    "securitycraft":   {"match": "SecurityCraft",          "role": "mod"},
    "enderutilities":  {"match": "enderutilities",         "role": "mod"},
    "architecturecraft":{"match": "ArchitectureCraft",     "role": "mod"},
    "doomlike":        {"match": "DoomlikeDungeons",       "role": "mod"},
    "damageindicators":{"match": "DamageIndicators",       "role": "mod"},
    "roguelike":       {"match": "roguelike",              "role": "mod"},
    "storagedrawers":  {"match": "StorageDrawers",         "role": "mod"},
    "carpenters":      {"match": "CarpentersBlocks",       "role": "mod"},
    "chunkpregen":     {"match": "ChunkPregenerator",      "role": "mod"},
    "compactmachines": {"match": "compactmachines",        "role": "mod"},
    "pandorasbox":     {"match": "PandorasBox",            "role": "mod"},
    "inventorytweaks": {"match": "InventoryTweaks",        "role": "mod"},
    "lootbags":        {"match": "LootBags",               "role": "mod"},
    "infernalmobs":    {"match": "InfernalMobs",           "role": "mod"},
    "ironchest":       {"match": "ironchest",              "role": "mod"},
    "secretrooms":     {"match": "secretroomsmod",         "role": "mod"},
    "mobproperties":   {"match": "MobProperties",          "role": "mod"},
    "killerpacman":    {"match": "KillerPacman",           "role": "mod"},
    "colorfulmobs":    {"match": "ColorfulMobs",           "role": "mod"},
    "luckyblocks":     {"match": "LuckyBlocks",            "role": "mod"},
    "luckyegg":        {"match": "LuckyEgg",               "role": "mod"},
    "levelup":         {"match": "LevelUp",                "role": "mod"},
    "hopperduct":      {"match": "hopperductmod",          "role": "mod"},
    "foodexpansion":   {"match": "FoodExpansion",          "role": "mod"},
    "chesttransporter":{"match": "ChestTransporter",       "role": "mod"},
    "mobstatues":      {"match": "MobStatues",             "role": "mod"},
    "controlling":     {"match": "Controlling",            "role": "mod"},
    "nomorerecipeconflict": {"match": "NoMoreRecipeConflict", "role": "mod"}
  }
}
