{
 "name": "textures-v1b",
 "owner": "texture-agent",
 "comment": "QF Textures v1 iteration b: clear-glass CTM under Angelica's own rule path (the first v1 render drew Angelica's 16x tiles), straw-coloured ripe wheat. Re-renders only the views those touch. Shot mode.",
 "prebuild": [
  [
   "py",
   "-3.10",
   "-I",
   "tools/textures/build_qf_textures.py",
   "--no-cit",
   "--out",
   "C:/qfb/textures/QFTextures-v1.zip"
  ],
  [
   "py",
   "-3.10",
   "-I",
   "tools/textures/build_qf_textures.py",
   "--no-cit",
   "--leaf-edges",
   "all",
   "--out",
   "C:/qfb/textures/QFTextures-v1-edges-all.zip"
  ],
  [
   "py",
   "-3.10",
   "-I",
   "tools/textures/build_qf_textures.py",
   "--no-cit",
   "--leaf-edges",
   "sides",
   "--out",
   "C:/qfb/textures/QFTextures-v1-edges-sides.zip"
  ]
 ],
 "defaults": {
  "world": "C:/qfb/textures/world-showcase",
  "preset": "3",
  "size": "2560x1440",
  "mode": "shot"
 },
 "jobs": [
  {
   "tag": "t8v1",
   "resourcepacks": [
    "C:/qfb/textures/QFTextures-v1.zip"
   ],
   "scenes": "texture_wall,texture_wall2,glass_close,farm,farm_close,leaves_close,tree_close"
  },
  {
   "tag": "t8e1",
   "resourcepacks": [
    "C:/qfb/textures/QFTextures-v1-edges-all.zip"
   ],
   "scenes": "leaves_close,tree_close"
  },
  {
   "tag": "t8e2",
   "resourcepacks": [
    "C:/qfb/textures/QFTextures-v1-edges-sides.zip"
   ],
   "scenes": "leaves_close,tree_close"
  },
  {
   "tag": "t8p1",
   "resourcepacks": [
    "C:/qfb/textures/QFTextures-v1.zip"
   ],
   "opts": {
    "QF_PBR": 1
   },
   "scenes": "texture_wall2,glass_close"
  }
 ]
}